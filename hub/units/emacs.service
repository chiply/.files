[Unit]
Description=Emacs daemon (zetta, headless profile) for SSH clients
# Skipped, not failed, until the cold build exists: starting an unbuilt
# zetta would clone and build every package inside the daemon, time out
# below, and loop under Restart=.  Meanwhile: systemctl --user start emacs-lean
ConditionPathExists=%h/.zetta.d/elpaca/builds

[Service]
Type=notify
# A user unit inherits systemd's minimal PATH, not the login shell's:
# measured 2026-09-11, the daemon could not see ~/.local/bin, so `fd'
# (the fdfind symlink the bootstrap makes) was invisible to consult and
# dired while it worked in every shell.  /usr/local/bin first so the
# source-built Emacs (install-emacs-source.sh) and its emacsclient win
# over apt's once they exist; until then this resolves to /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Default socket, so `emacsclient -t` and the e/ei aliases are unchanged.
# `env' rather than a fixed binary: the same unit runs apt's emacs-nox
# and the source build, whichever PATH finds first.
ExecStart=/usr/bin/env emacs --fg-daemon --init-directory=%h/.zetta.d
ExecStop=/usr/bin/env emacsclient --eval "(kill-emacs)"
Restart=on-failure
# READY=1 reaches systemd only when init finishes.  Measured 2026-09-11
# after the cold build: emacs-init-time 3.7 s, restart-to-ready 9 s
# (the modules load byte-compiled).  300 s is the old lean unit's
# window and leaves room for elpaca to rebuild a changed package at
# start after a `git pull' that skipped `bin/zetta build'.
TimeoutStartSec=300

[Install]
WantedBy=default.target
