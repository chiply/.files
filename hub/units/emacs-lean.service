[Unit]
Description=Emacs daemon (lean fallback init) on socket "lean"

[Service]
Type=notify
# Own socket, so it can run beside the zetta daemon.  Reach it with
# `emacsclient -s lean -t`.  Installed by the bootstrap, never enabled:
# start it by hand when zetta is broken or not yet built.
ExecStart=/usr/bin/emacs --fg-daemon=lean --init-directory=%h/.emacs.d
ExecStop=/usr/bin/emacsclient -s lean --eval "(kill-emacs)"
Restart=on-failure
# first start after a config deploy may install packages from MELPA
TimeoutStartSec=300

[Install]
WantedBy=default.target
