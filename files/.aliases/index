#### builtins

# ls
alias l="ls"
alias la="ls -a"
alias lah="ls -lah"
alias lahl="ls -lah | less"

# clear
alias c="clear"

# refreshing shell config
alias zefresh="source ~/.zshrc"
alias befresh="source ~/.bashrc"


#### 3rd Party

# cheat.sh
alias how="cht.sh"

# bat
alias cat='bat --paging=never'

# other files
source ~/.aliases/emacs
source ~/.aliases/tmux
source ~/.aliases/python
