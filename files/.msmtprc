# msmtp configuration — SMTP send for mu4e/message-mode.
#
# Account names match the mbsync accounts in ~/.mbsyncrc and the `-a <account>`
# argument set by `timu/set-msmtp-account' in ~/.private.el.
#
# Passwords are Gmail App Passwords stored in 1Password, read on demand via the
# `op' CLI — the same source mbsync uses (PassCmd in ~/.mbsyncrc). No secrets
# live in this file.

# ── Defaults for all accounts ────────────────────────────────────────
defaults
auth           on
tls            on
tls_starttls   on
tls_trust_file /opt/homebrew/etc/ca-certificates/cert.pem
logfile        ~/.msmtp.log

# ── misterchiply@gmail.com ───────────────────────────────────────────
account gmail-misterchiply
host    smtp.gmail.com
port    587
from    misterchiply@gmail.com
user    misterchiply@gmail.com
passwordeval "op read 'op://Dev/Gmail-misterchiply/app-password'"

# ── charliebkr707@gmail.com ──────────────────────────────────────────
account gmail-charliebkr707
host    smtp.gmail.com
port    587
from    charliebkr707@gmail.com
user    charliebkr707@gmail.com
passwordeval "op read 'op://Dev/Gmail-charliebkr707/app-password'"

# ── charliechristopherbaker@gmail.com ────────────────────────────────
account gmail-charliechristopherbaker
host    smtp.gmail.com
port    587
from    charliechristopherbaker@gmail.com
user    charliechristopherbaker@gmail.com
passwordeval "op read 'op://Dev/Gmail-charliechristopherbaker/app-password'"

# Fallback when no -a is given (mu4e always passes -a via the hook).
account default : gmail-charliebkr707
