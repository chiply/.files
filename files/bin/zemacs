#!/usr/bin/env bash
#
# zemacs -- launch any installed Emacs build against any chemacs profile.
#
# chemacs answers "which config?"; nothing answers "which Emacs?".  With
# several vendors installed side by side (emacs-plus from Homebrew, the
# emacs-mac fork, local source builds) picking a binary meant hand-written
# aliases, one per build/profile pair, that went stale on every upgrade.
#
# This is the layer above chemacs: builds are DISCOVERED rather than listed,
# so installing emacs-plus@32 or bumping the source build makes a new command
# appear without editing anything.
#
#   zemacs list                       what is installed, and which profiles exist
#   zemacs run <build> [--<profile>] [emacs args...]
#   zemacs client <build> [args...]   emacsclient on that build's own socket
#   zemacs shims                      (re)generate the ~/bin/emacs-* commands
#
# ZEMACS_DRY_RUN=1 prints the command that would run instead of running it.
#
# The shims are the point of daily use:
#
#   emacs-src-latest --zetta          newest source build, ~/.zetta.d
#   emacs-plus-31 --zetta-mac -nw     a specific build, in the terminal
#   emacs-src-32 --zetta --daemon     daemon on socket "src-32"
#
# A `--<name>' that matches a profile in ~/.emacs-profiles.el selects that
# profile.  On Emacs 29+ its directory goes along as `--init-directory <dir>',
# which makes the directory's early-init.el and eln-cache the ones in use;
# chemacs's `--with-profile <name>' still picks the init file, because Emacs
# tries ~/.emacs (chemacs) before <dir>/init.el.  Everything else is passed
# to Emacs untouched.

set -euo pipefail

PROFILES_FILE="${ZEMACS_PROFILES_FILE:-$HOME/.emacs-profiles.el}"   # override for tests
STATE_DIR="$HOME/.local/state/zemacs"
CACHE="$STATE_DIR/builds.tsv"
SHIM_DIR="$HOME/bin"
SHIM_MARK="# generated by zemacs shims -- do not edit"

say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m==>\033[0m %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Discovery
#
# Emits: id <TAB> version <TAB> vendor <TAB> binary <TAB> app (or "-")
#
# Probing the version means running each Emacs, so results are cached and
# refreshed only when a binary is newer than the cache.  A bumped source build
# replaces its bundle, so its mtime moves and the cache invalidates itself.
# ---------------------------------------------------------------------------

probe_version() { # binary
    "$1" --batch --eval '(princ emacs-version)' 2>/dev/null || echo ""
}

discover() {
    local bin ver app

    # emacs-plus, via Homebrew's opt symlinks (the linked, usable versions).
    for d in "$(brew --prefix 2>/dev/null || echo /opt/homebrew)"/opt/emacs-plus@*; do
        bin="$d/bin/emacs"
        [ -x "$bin" ] || continue
        ver="$(probe_version "$bin")"
        [ -n "$ver" ] || continue
        app="$d/Emacs.app"; [ -d "$app" ] || app="-"
        printf 'plus-%s\t%s\tplus\t%s\t%s\n' "${ver%%.*}" "$ver" "$bin" "$app"
    done

    # App bundles: the emacs-mac fork and the source builds.
    for app in "$HOME/Applications"/Emacs*.app "$HOME/Applications"/Emacs*.app.prev; do
        [ -d "$app" ] || continue
        bin="$app/Contents/MacOS/Emacs"
        [ -x "$bin" ] || continue
        ver="$(probe_version "$bin")"
        [ -n "$ver" ] || continue
        case "$app" in
            *EmacsMac*)      printf 'mac-%s\t%s\tmac\t%s\t%s\n'  "${ver%%.*}" "$ver" "$bin" "$app" ;;
            *EmacsSrc*.prev) printf 'src-prev\t%s\tsrc\t%s\t%s\n'              "$ver" "$bin" "$app" ;;
            *EmacsSrc*)      printf 'src-%s\t%s\tsrc\t%s\t%s\n'  "${ver%%.*}" "$ver" "$bin" "$app" ;;
        esac
    done
}

cache_stale() {
    [ -f "$CACHE" ] || return 0
    local bin
    while IFS=$'\t' read -r _ _ _ bin _; do
        [ -e "$bin" ] || return 0            # a build was removed
        [ "$bin" -nt "$CACHE" ] && return 0  # a build was replaced
    done < "$CACHE"
    # A newly installed build has no row yet, so also age the cache out.
    [ -n "$(find "$CACHE" -mmin +1440 2>/dev/null)" ]
}

builds() {
    mkdir -p "$STATE_DIR"
    if [ "${1:-}" = "--refresh" ] || cache_stale; then
        discover > "$CACHE.tmp" && mv "$CACHE.tmp" "$CACHE"
    fi
    cat "$CACHE"
}

# `<vendor>-latest' resolves to that vendor's highest version.  `src-prev' is
# deliberately excluded -- it is the rollback bundle, never the newest thing.
resolve() { # id -> row
    local want="$1" rows vendor
    rows="$(builds)"
    case "$want" in
        *-latest)
            vendor="${want%-latest}"
            echo "$rows" | awk -F'\t' -v v="$vendor" '$3==v && $1!="src-prev"' \
                | sort -t$'\t' -k2 -V | tail -1
            ;;
        latest)
            echo "$rows" | awk -F'\t' '$1!="src-prev"' | sort -t$'\t' -k2 -V | tail -1
            ;;
        *)  echo "$rows" | awk -F'\t' -v i="$want" '$1==i' ;;
    esac
}

profiles() {
    [ -f "$PROFILES_FILE" ] || return 0
    grep -oE '^\s*\("[A-Za-z0-9_.-]+"' "$PROFILES_FILE" | tr -d '(" \t'
}

# The directory of a profile that is ONLY a directory, else "".
#
# chemacs v1 (~/.emacs) sets `user-emacs-directory' from the init file --
# after Emacs has already looked for early-init.el in ~/.emacs.d.  On the
# personal Mac a hand-made ~/.emacs.d/early-init.el symlink papered over
# that; a fresh machine had none, so zetta's JIT deny-list never applied,
# the bootstrap was native-compiled from source in a bare worker, and the
# second daemon start died with "void: compile-angel".  `--init-directory'
# (Emacs 29+) sets the directory before early-init.el is looked up and puts
# eln-cache under it, so the profile's early-init.el is honoured wherever
# the profile is launched.  It does NOT replace chemacs: Emacs still tries
# ~/.emacs before <dir>/init.el (startup.el), so `--with-profile' goes along
# whenever chemacs is installed, and alone for a profile carrying any other
# chemacs key (custom-file, server-name, env, straight-p).
chemacs_installed() { [ -f "${ZEMACS_CHEMACS_INIT:-$HOME/.emacs}" ] && grep -q chemacs "${ZEMACS_CHEMACS_INIT:-$HOME/.emacs}"; }

profile_dir() { # name -> directory, or "" when --with-profile alone is right
    [ -f "$PROFILES_FILE" ] || return 0
    local entry
    entry="$(awk -v n="$1" '
        $0 ~ "^[ \t]*\\(\"" n "\"" { on = 1; print; next }
        on && $0 ~ /^[ \t]*\("/      { exit }
        on && $0 !~ /^[ \t]*;/        { print }' "$PROFILES_FILE")"
    [ -n "$entry" ] || return 0
    grep -qE '\((custom-file|server-name|env|straight-p)[[:space:]]*\.' <<< "$entry" && return 0
    local dir
    dir="$(grep -oE 'user-emacs-directory[[:space:]]*\.[[:space:]]*"[^"]+"' <<< "$entry" \
           | head -1 | sed -E 's/.*"([^"]+)"/\1/')"
    printf '%s\n' "${dir/#\~/$HOME}"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_list() {
    printf '\033[1m%-12s %-10s %-8s %s\033[0m\n' BUILD VERSION VENDOR PATH
    builds "${1:-}" | while IFS=$'\t' read -r id ver vendor bin app; do
        printf '%-12s %-10s %-8s %s\n' "$id" "$ver" "$vendor" "${app#-}"
    done
    echo
    echo "aliases:  $(builds | awk -F'\t' '{print $3}' | sort -u | sed 's/$/-latest/' | tr '\n' ' ')latest"
    echo "profiles: $(profiles | tr '\n' ' ')"
}

cmd_run() {
    [ $# -ge 1 ] || die "usage: zemacs run <build> [--<profile>] [emacs args...]"
    local want="$1"; shift

    local row; row="$(resolve "$want")"
    [ -n "$row" ] || die "unknown build: $want
Known: $(builds | cut -f1 | tr '\n' ' ')
       plus the <vendor>-latest aliases.  \`zemacs list' shows everything."

    local id ver vendor bin app
    IFS=$'\t' read -r id ver vendor bin app <<< "$row"

    # Split the argument list: a --<name> matching a chemacs profile becomes
    # --with-profile; everything else is Emacs's business, not ours.
    local -a passthru=() ; local profile="" terminal="" daemon=""
    local known; known="$(profiles)"
    for arg in "$@"; do
        case "$arg" in
            --*)
                local name="${arg#--}"
                if [ -n "$name" ] && grep -qx "$name" <<< "$known"; then
                    profile="$name"; continue
                fi
                ;;
        esac
        case "$arg" in
            -nw|-t|--tty|--batch|--script|--fg) terminal=t ;;
            --daemon|--fg-daemon)               daemon=t; terminal=t ;;
            --daemon=*|--fg-daemon=*)           daemon=named; terminal=t ;;
        esac
        [ "$arg" = "--fg" ] || passthru+=("$arg")
    done

    # The profile: --init-directory on a build that takes it, plus chemacs's
    # --with-profile whenever chemacs is installed (see profile_dir).
    local -a pre=()
    if [ -n "$profile" ]; then
        local dir=""
        [ "${ver%%.*}" -ge 29 ] 2>/dev/null && dir="$(profile_dir "$profile")"
        [ -n "$dir" ] && pre+=(--init-directory="$dir")
        if [ -z "$dir" ] || chemacs_installed; then pre+=(--with-profile "$profile"); fi
    fi

    # A bare --daemon gets the VENDOR as its socket name, not the build id:
    # the socket then survives a version bump, so `emacsclient -s src' keeps
    # working after the source build moves 32 -> 33.  Two builds of the same
    # vendor daemonising at once is the rare case; pass --daemon=NAME for that.
    if [ "$daemon" = t ]; then
        local -a rewritten=()
        for arg in ${passthru[@]+"${passthru[@]}"}; do
            case "$arg" in
                --daemon)    rewritten+=("--daemon=$vendor") ;;
                --fg-daemon) rewritten+=("--fg-daemon=$vendor") ;;
                *)           rewritten+=("$arg") ;;
            esac
        done
        passthru=("${rewritten[@]}")
        say "daemon socket: $vendor  (connect with: zemacs client $want, or emacsclient -s $vendor)"
    fi

    # GUI launches go through `open' so they detach from the shell and get
    # proper app activation; anything terminal-shaped has to stay attached.
    if [ -z "$terminal" ] && [ "$app" != "-" ] && [ -d "$app" ]; then
        [ -n "${ZEMACS_DRY_RUN:-}" ] \
            && { printf 'open -a %s --args %s %s\n' "$app" "${pre[*]:-}" "${passthru[*]:-}"; return 0; }
        exec open -a "$app" --args ${pre[@]+"${pre[@]}"} ${passthru[@]+"${passthru[@]}"}
    fi
    [ -n "${ZEMACS_DRY_RUN:-}" ] \
        && { printf '%s %s %s\n' "$bin" "${pre[*]:-}" "${passthru[*]:-}"; return 0; }
    exec "$bin" ${pre[@]+"${pre[@]}"} ${passthru[@]+"${passthru[@]}"}
}

cmd_client() {
    [ $# -ge 1 ] || die "usage: zemacs client <build> [emacsclient args...]"
    local want="$1"; shift
    local row; row="$(resolve "$want")"
    [ -n "$row" ] || die "unknown build: $want"
    local vendor; vendor="$(cut -f3 <<< "$row")"
    exec emacsclient -s "$vendor" "$@"
}

cmd_shims() {
    mkdir -p "$SHIM_DIR"

    # Remove only our own shims, identified by the marker, so anything else
    # living in ~/bin is left alone.
    local f
    for f in "$SHIM_DIR"/emacs-*; do
        [ -f "$f" ] || continue
        grep -q "$SHIM_MARK" "$f" 2>/dev/null && rm -f "$f"
    done

    local -a names=()
    while IFS=$'\t' read -r id _ _ _ _; do names+=("$id"); done < <(builds --refresh)
    while read -r vendor; do names+=("$vendor-latest"); done \
        < <(builds | awk -F'\t' '{print $3}' | sort -u)
    names+=(latest)

    for id in "${names[@]}"; do
        f="$SHIM_DIR/emacs-$id"
        cat > "$f" <<EOF
#!/bin/sh
$SHIM_MARK
exec "\$HOME/bin/zemacs" run "$id" "\$@"
EOF
        chmod +x "$f"
    done
    say "wrote ${#names[@]} shims to $SHIM_DIR: $(printf 'emacs-%s ' "${names[@]}")"
}

case "${1:-list}" in
    list)    shift || true; cmd_list "${1:-}" ;;
    refresh) builds --refresh >/dev/null; cmd_list ;;
    run)     shift; cmd_run "$@" ;;
    client)  shift; cmd_client "$@" ;;
    shims)   cmd_shims ;;
    -h|--help) sed -n '3,32p' "${BASH_SOURCE[0]}" ;;
    *)       cmd_run "$@" ;;   # `zemacs src-latest --zetta' also works
esac
