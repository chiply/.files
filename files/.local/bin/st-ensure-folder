#!/usr/bin/env bash
# Ensure a Syncthing folder is registered with the local daemon (idempotent).
# Usage: st-ensure-folder <folder-id> <path> [label]
#
# Creates the directory if missing, registers the folder with the running
# Syncthing, and gives it an include-style .stignore (patterns arrive via
# the synced .stignore-shared). Device pairing/sharing stays manual —
# device IDs are per-machine: GUI at http://localhost:8384.
set -euo pipefail

id="${1:?usage: st-ensure-folder <folder-id> <path> [label]}"
dir="${2:?usage: st-ensure-folder <folder-id> <path> [label]}"
label="${3:-$id}"

mkdir -p "$dir"

# include target must exist or Syncthing errors the folder; content syncs
# in from peers later and identical bytes never conflict
if [ ! -f "$dir/.stignore-shared" ]; then
    seed="$(dirname "$(dirname "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")")")/hub/seed/stignore-shared"
    if [ -f "$seed" ]; then cp "$seed" "$dir/.stignore-shared"; else touch "$dir/.stignore-shared"; fi
fi
[ -f "$dir/.stignore" ] || echo "#include .stignore-shared" > "$dir/.stignore"

# The daemon may still be starting (brew services / systemd are async on a
# fresh machine) — wait briefly, and degrade gracefully rather than fail
# the whole bootstrap: registration is idempotent and can be re-run later.
for _ in $(seq 1 15); do
    if syncthing cli config folders list >/dev/null 2>&1; then
        if syncthing cli config folders list | grep -qx "$id"; then
            echo "syncthing folder '$id' already configured"
        else
            syncthing cli config folders add --id "$id" --label "$label" --path "$dir"
            echo "syncthing folder '$id' added at $dir"
        fi
        exit 0
    fi
    sleep 1
done
echo "WARN: syncthing daemon not reachable; folder '$id' prepared on disk but not registered — re-run: st-ensure-folder $id $dir" >&2
exit 0
