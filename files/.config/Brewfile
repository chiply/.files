# ── emacs-mac (experimental trial) ──────────────────────────────────
# Build deps for the jdtsmith emacs-mac fork (Emacs 30, retina-correct
# images), run side-by-side with emacs-plus@31.  Gated on
# INCLUDE_EMACS_MAC (files/.zshrc); build happens in
# install_emacs_distros.sh.  tree-sitter@0.25: the Emacs 30 branch
# needs the older tree-sitter ABI (keg-only; configure gets CFLAGS/
# LDFLAGS pointing at it).
if gate.call("INCLUDE_EMACS_MAC", "") == "t"
  brew "autoconf"
  brew "pkgconf"
  brew "texinfo"
  brew "libgccjit"
  brew "librsvg"
  brew "tree-sitter@0.25"
end

# ---------------------------------------------------------------------
# Fonts
#
# The Nerd Fonts catalogue plus a wide monospace selection, so the
# fontaine picker has something to offer.  Presets are GENERATED from
# whatever is installed (zetta-fontaine-refresh-font-presets), and the
# generator filters to monospaced families, so a non-mono cask here
# costs disk but never clutters the picker.
#
# Two are load-bearing rather than a matter of taste:
#
#   font-terminess-ttf-nerd-font  the SVG mode line / tab line / tab bar
#                                 chrome font.  It must advance icons and
#                                 text identically, and almost nothing
#                                 does -- see ~/.zetta.d/FONTS.org.
#   font-terminus                 the font the metric corrections were
#                                 originally derived from.
# ---------------------------------------------------------------------
