# ── emacs-mac (experimental trial) ──────────────────────────────────
# Build deps for the jdtsmith emacs-mac fork (Emacs 30, retina-correct
# images), run side-by-side with emacs-plus@31.  Gated on
# INCLUDE_EMACS_MAC (files/.zshrc); build happens in
# install_emacs_distros.sh.  tree-sitter@0.25: the Emacs 30 branch
# needs the older tree-sitter ABI (keg-only; configure gets CFLAGS/
# LDFLAGS pointing at it).
if ENV["INCLUDE_EMACS_MAC"] == "t"
  brew "autoconf"
  brew "pkgconf"
  brew "texinfo"
  brew "libgccjit"
  brew "librsvg"
  brew "tree-sitter@0.25"
end

# ---------------------------------------------------------------------
# Fonts
#
# The full Nerd Fonts catalogue plus Terminus and Monaspace. Two of these
# are load-bearing rather than a matter of taste:
#
#   font-terminess-ttf-nerd-font  the SVG mode line / tab line / tab bar
#                                 chrome font. It must advance icons and
#                                 text identically, and almost nothing
#                                 does -- see ~/.zetta.d/FONTS.org.
#   font-terminus                 the default buffer font the metric
#                                 corrections were originally derived for.
#
# The rest are buffer fonts, selectable per preset via fontaine.
# ---------------------------------------------------------------------
