# Profile: `personal' (default) or `work' -- DOTFILES_PROFILE, set in
# ~/.zshenv.local or by bootstrap.sh --profile.  The personal blocks below
# pair the machine with personal accounts or infrastructure and are
# skipped at work (README.md, "Profiles"; work-profile.org Part 6.5).
#
# `brew' filters the environment before running Ruby: only HOMEBREW_*
# variables (and a short fixed list) reach this file -- measured
# 2026-09-13 with `brew ruby': DOTFILES_PROFILE and INCLUDE_EMACS_MAC
# arrive as nil, HOMEBREW_X as set.  .zshenv/.zshrc and bootstrap.sh
# therefore export HOMEBREW_ mirrors of the three gates; the plain names
# are read too, for a `brew bundle' invoked from a shell that skipped them.
gate = lambda { |name, default| ENV.fetch("HOMEBREW_#{name}", ENV.fetch(name, default)) }
personal = gate.call("DOTFILES_PROFILE", "personal") != "work"

