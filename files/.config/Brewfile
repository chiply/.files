# ── emacs from source (upstream master) ─────────────────────────────
# Build and runtime deps for install_emacs_source.sh, which compiles
# GNU Emacs master (32.0.50, canvas) into ~/Applications/EmacsSrc.app
# alongside emacs-plus@31.  Gated on INCLUDE_EMACS_SRC (files/.zshrc).
#
# Every one of these is already an emacs-plus@31 dependency, but most
# are declared there as build-time only -- the same trap documented
# above for jpeg/zlib: `brew autoremove` strips them and the binary
# then fails to launch. Declaring them here (installed-on-request)
# keeps EmacsSrc.app working even if emacs-plus@31 is ever removed.
if gate.call("INCLUDE_EMACS_SRC", "") == "t"
  # build
  brew "autoconf"
  brew "automake"
  brew "texinfo"
  brew "gnu-sed"
  brew "gnu-tar"
  brew "coreutils"
  brew "grep"
  brew "m4"
  brew "xz"
  brew "make"
  brew "pkgconf"
  # link-time and runtime
  brew "gnutls"
  brew "librsvg"
  brew "little-cms2"
  brew "webp"
  brew "tree-sitter"
  brew "imagemagick"
  brew "sqlite"
  brew "gmp"
  brew "jpeg"
  brew "zlib"
  brew "dbus"
  # native compilation
  brew "libgccjit"
  brew "gcc"
  # Rust, for dynamic modules against the Emacs 32 canvas API (see
  # install_emacs_canvas_rs.sh).  Already declared unconditionally above;
  # repeated here so removing the ungated entry cannot silently break the
  # module build.  bindgen's libclang comes from the Xcode command line
  # tools, which bootstrap.sh installs.
  brew "rust"
end
